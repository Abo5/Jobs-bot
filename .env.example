# انسخ هذا الملف إلى .env وعبّي القيم الحسّاسة:
#   cp .env.example .env

# ===== تشغيل عام =====
ENABLE_AI=true
ENABLE_GOOGLE=true
ENABLE_NAUKRIGULF=true
ENABLE_APIS=true
ENABLE_TELEGRAM=true

# بوابة AI تتأكد إن كل وظيفة هي QA/QC برمجيات فعلاً (لا جودة إنشاءات/مصانع/ISO).
# تكلفتها استدعاء واحد لكل ٢٥ وظيفة. أطفئها لو حد معدل NVIDIA ضايقك.
ENABLE_AI_QA_GATE=true
QA_CLASSIFY_BATCH=25

# مصادر عالمية (Remotive/Arbeitnow/RemoteOK/Jobicy/Himalayas/TheMuse) —
# معطّلة لأنها أمريكا/أوروبا بالدرجة الأولى ونادراً وظائف سعودية حقيقية.
ENABLE_GLOBAL_REMOTE_APIS=false

MAX_PAGES=1
MAX_AI_LINKS=40
MAX_AI_PARALLEL=3
ENABLE_SAUDI_SITES=true

# وظائف العرب (jobs-arab.com) عبر RSS — الموقع عنده حد معدل صارم.
ENABLE_JOBS_ARAB=true
JOBS_ARAB_DELAY_MS=6000
JOBS_ARAB_MAX_KEYWORDS=5

# NaukriGulf: بحث موجّه بالكلمات على مستوى الخادم (بارامتر Keywords).
NG_API_KEYWORD_PAGES=2

GOOGLE_REGION=sa
GOOGLE_LANG=en
SMART_QUERY_CITIES_PER_ROLE=2

API_RESULTS_PER_SOURCE=40
API_PARALLEL=6
API_COUNTRY=sa

# ===== NVIDIA AI (تحليل واستخراج الوظائف) =====
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MAX_TOKENS=

# ===== Telegram (النشر) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== مفاتيح اختيارية لمصادر إضافية (تتفعّل تلقائياً عند إضافتها) =====
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=gb
# JOOBLE_KEY=
# FINDWORK_KEY=
# CAREERJET_AFFID=
# JSEARCH_RAPIDAPI_KEY=

# ===== لوحات ATS للشركات (Greenhouse/Workable/Recruitee/SmartRecruiters) =====
# JSON عام بلا مفتاح، وما يتأثر بحجب Cloudflare. الشركات في sources/atsBoards.js
ENABLE_ATS=true
ATS_MAX_PER_COMPANY=60
ATS_TIMEOUT_MS=15000

# إثراء وظائف العرب من صفحة كل وظيفة (JSON-LD ثم جدول HTML كبديل):
# يجيب اسم الشركة والمدينة والمنطقة ونوع الدوام والراتب. يشتغل بعد الفلترة فقط.
JOBS_ARAB_DETAIL_MAX=30
JOBS_ARAB_DETAIL_DELAY_MS=2000

# ===== LinkedIn =====
# تدوير الكلمات: كل تشغيلة (كل ساعتين) تبحث 8 من 36 كلمة — تغطية كاملة كل 10
# ساعات بحِمل يومي 96 استدعاء. صفّرها لتمرير كل الكلمات كل مرة.
KEYWORD_SLICE=8
LI_MAX_PAGES=4
LI_PER_KEYWORD=20
LI_FRESH_PER_KEYWORD=30
LI_DETAILS_MAX=40
LI_CITIES=Riyadh,Jeddah,Dammam,Khobar,Mecca
LI_BACKOFF_MS=25000

# مراقبة الجهات شبه الحكومية (entities.json) — 6 جهات لكل تشغيلة، تغطية كل 12 ساعة
ENABLE_ENTITIES=true
ENTITY_SLICE=6
ENTITY_MAX_PAGES=3

# قاطع دوائر لنكدإن (lib/liGate.js): بعد 4 استجابات 429 صعبة يُجمَّد لنكدإن بقية
# التشغيلة وتُسجَّل تهدئة 45 دقيقة تتخطّى فيها التشغيلات الجاية لنكدإن كلياً —
# فلا يعيق حظر لنكدإن المؤقت جلب الوظائف من بقية المصادر أبداً.
LI_RL_MAX_HITS=4
LI_RL_COOLDOWN_MS=2700000
