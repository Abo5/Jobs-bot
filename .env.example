# انسخ هذا الملف إلى .env وعبّي القيم الحسّاسة:
#   cp .env.example .env

# ===== تشغيل عام =====
ENABLE_AI=true
ENABLE_GOOGLE=true
ENABLE_NAUKRIGULF=true
ENABLE_APIS=true
ENABLE_TELEGRAM=true

# مصادر عالمية (Remotive/Arbeitnow/RemoteOK/Jobicy/Himalayas/TheMuse) —
# معطّلة لأنها أمريكا/أوروبا بالدرجة الأولى ونادراً وظائف سعودية حقيقية.
ENABLE_GLOBAL_REMOTE_APIS=false

MAX_PAGES=1
MAX_AI_LINKS=40
MAX_AI_PARALLEL=3
ENABLE_SAUDI_SITES=true

# وظائف العرب (jobs-arab.com) عبر RSS — الموقع عنده حد معدل صارم.
ENABLE_JOBS_ARAB=true
JOBS_ARAB_DELAY_MS=6000
JOBS_ARAB_MAX_KEYWORDS=5

# NaukriGulf: بحث موجّه بالكلمات على مستوى الخادم (بارامتر Keywords).
NG_API_KEYWORD_PAGES=2

GOOGLE_REGION=sa
GOOGLE_LANG=en
SMART_QUERY_CITIES_PER_ROLE=2

API_RESULTS_PER_SOURCE=40
API_PARALLEL=6
API_COUNTRY=sa

# ===== NVIDIA AI (تحليل واستخراج الوظائف) =====
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MAX_TOKENS=

# ===== Telegram (النشر) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== مفاتيح اختيارية لمصادر إضافية (تتفعّل تلقائياً عند إضافتها) =====
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=gb
# JOOBLE_KEY=
# FINDWORK_KEY=
# CAREERJET_AFFID=
# JSEARCH_RAPIDAPI_KEY=
